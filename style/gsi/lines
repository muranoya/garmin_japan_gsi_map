# ---- 等高線 ----
# ftCode 7351 通常部 / 7352 数値部 / 7353 崖部。等深線（737x）は扱わない。
# 標高は Garmin の慣例に従いフィートで名前に入れる（端末側で設定単位に換算表示される）。
# ズームアウトに応じて 補助曲線 → 主曲線(10m) → 計曲線(50m) → 100m ごと の順に間引く。
# 判定は標高の末尾の数字で行う（例: 100m ごとは末尾 "00"）。
gsi_layer=contour & ftCode ~ '735[123]' & alti ~ '-?[0-9]*00'
    { name '${alti|conv:m=>ft}' } [0x22 resolution 20]
gsi_layer=contour & ftCode ~ '735[123]' & alti ~ '-?[0-9]*50'
    { name '${alti|conv:m=>ft}' } [0x22 resolution 21]
gsi_layer=contour & ftCode ~ '735[123]' & alti ~ '-?[0-9]*0'
    { name '${alti|conv:m=>ft}' } [0x21 resolution 23]
gsi_layer=contour & ftCode ~ '735[123]'
    { name '${alti|conv:m=>ft}' } [0x20 resolution 24]

# ---- 道路 ----
# ftCode 2721-2723 徒歩道 / 2731-2734 石段 / 2711,2713,2714 庭園路
# rdCtg 0 国道 / 1 都道府県道 / 2,5,6 市区町村道・その他
# rnkWidth 0 3m未満 / 1 3-5.5m / 2 5.5-13m / 3 13-19.5m / 4 19.5m以上
gsi_layer=road & ftCode ~ '272[123]|273[1-4]' [0x16 resolution 22]
gsi_layer=road & motorway=1 [0x01 resolution 18]
gsi_layer=road & ftCode ~ '271[134]' [0x07 resolution 23]
gsi_layer=road & rdCtg=0 [0x02 resolution 18]
gsi_layer=road & rdCtg=1 [0x03 resolution 19]
gsi_layer=road & rnkWidth ~ '[2-9]' [0x05 resolution 20]
gsi_layer=road & rnkWidth=1 [0x06 resolution 21]
gsi_layer=road [0x07 resolution 22]

# ---- 鉄道 ----
gsi_layer=railway [0x14 resolution 21]

# ---- 河川 ----
# 5201,5301 通常部 / 5203 堤防等に接する部分 / 5302 枯れ川部 / 5321 人工水路（空間）/ 5322 人工水路（地下）
gsi_layer=river & ftCode ~ '5201|5203|5301' [0x18 resolution 21]
gsi_layer=river & ftCode=5302 [0x26 resolution 22]
gsi_layer=river & ftCode=5321 [0x18 resolution 23]

# ---- 境界・構造物 ----
# 1211 都府県界 / 1212 市区町村界 / 8202 送電線
gsi_layer=boundary & ftCode=1211 [0x1d resolution 19]
gsi_layer=boundary & ftCode=1212 [0x1c resolution 21]
gsi_layer=structurel & ftCode=8202 [0x29 resolution 22]

# ---- 地形表現（landforml）----
# 7501,7502,7509,7511,7512,7541 岩・崖等 / 7521 雨裂（上部）/ 5521 滝（線）
# 0x10e00 以降は Garmin 標準にない拡張種別。表示は TYP（style/gsi.typ.txt）で定義する
gsi_layer=landforml & ftCode ~ '750[129]|751[12]|7541' [0x10e00 resolution 22]
gsi_layer=landforml & ftCode=7521 [0x10e01 resolution 23]
gsi_layer=landforml & ftCode=5521 [0x10e02 resolution 22]
